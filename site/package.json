{
  "name": "takeout-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.3.0",
    "npm": "10.8.3"
  },
  "packageManager": "bun@1.2.22",
  "scripts": {
    "dev": "one dev",
    "prebuild": "bun scripts/generate-images.tsx",
    "build": "one build",
    "images": "bun scripts/generate-images.tsx",
    "serve": "one serve",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxfmt && oxlint --fix --fix-suggestions",
    "typecheck": "tsc --noEmit",
    "check:all": "bun lint && bun typecheck",
    "skills": "bun scripts/generate-skills.ts",
    "postinstall": "bun run skills",
    "up": "tko upgrade"
  },
  "dependencies": {
    "@tamagui/config": "^2.0.0-rc.23",
    "@tamagui/react-native-svg": "^2.0.0-rc.23",
    "@tamagui/vite-plugin": "^2.0.0-rc.23",
    "@vxrn/color-scheme": "^1.2.70",
    "@vxrn/mdx": "^1.2.70",
    "expo-linear-gradient": "^15.0.8",
    "mdx-bundler": "^10.0.2",
    "one": "^1.2.70",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-svg": "^15.15.1",
    "remark-smartypants": "^3.0.2",
    "satori": "^0.19.1",
    "sharp": "^0.34.5",
    "tamagui": "^2.0.0-rc.23"
  },
  "overrides": {
    "react-native-web": "npm:@tamagui/react-native-web-lite@2.0.0-rc.23",
    "esbuild": "0.27.2"
  },
  "devDependencies": {
    "@take-out/cli": "0.0.42",
    "@types/bun": "^1.3.5",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "bun-types": "^1.3.5",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0",
    "playwright": "^1.57.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
