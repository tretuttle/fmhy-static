e Play Books","url":"https://play.google.com/books","icon":null,"noteId":null,"route":null}],"code":[],"id":"beginners-guide/reading/2","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Manga","url":null,"mirrors":[],"alternatives":[],"description":null,"tags":[],"platforms":[],"nsfw":false,"links":[{"label":"Weeb Central","url":"https://weebcentral.com/","icon":null,"noteId":null,"route":null},{"label":"Comix","url":"https://comix.to/","icon":null,"noteId":null,"route":null}],"code":[],"id":"beginners-guide/reading/3","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Comics","url":null,"mirrors":[],"alternatives":[],"description":null,"tags":[],"platforms":[],"nsfw":false,"links":[{"label":"BatCave","url":"https://batcave.biz/","icon":null,"noteId":null,"route":null},{"label":"ReadComicsOnline","url":"https://rcostation.xyz/","icon":null,"noteId":null,"route":null},{"label":"GetComics","url":"https://getcomics.org/","icon":null,"noteId":null,"route":null}],"code":[],"id":"beginners-guide/reading/4","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Android Readers","url":null,"mirrors":[],"alternatives":[],"description":null,"tags":[],"platforms":[],"nsfw":false,"links":[{"label":"Librera","url":"https://librera.mobi/","icon":null,"noteId":null,"route":null},{"label":"Moon+ Reader","url":"https://www.moondownload.com/","icon":null,"noteId":null,"route":null},{"label":"Theme Guide","url":"https://clarasguide.valeena.workers.dev/Guides/moontheme/","icon":null,"noteId":null,"route":null}],"code":[],"id":"beginners-guide/reading/5","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Track / Discover","url":null,"mirrors":[],"alternatives":[],"description":"(books) / StoryGraph (books) / MAL (manga) / LeagueOfComicGeeks (comics)","tags":[],"platforms":[],"nsfw":false,"links":[{"label":"GoodReads","url":"https://www.goodreads.com/","icon":null,"noteId":null,"route":null},{"label":"StoryGraph","url":"https://www.thestorygraph.com/","icon":null,"noteId":null,"route":null},{"label":"MAL","url":"https://myanimelist.net/","icon":null,"noteId":null,"route":null},{"label":"LeagueOfComicGeeks","url":"https://leagueofcomicgeeks.com/","icon":null,"noteId":null,"route":null}],"code":[],"id":"beginners-guide/reading/6","crossrefRoute":null}],"subsections":[]},{"id":"privacy","title":"Privacy","refUrl":null,"crossrefRoute":null,"notice":{"kind":"tip","markdown":"**I don't have anything to hide, why should I care about privacy?**\n\nPrivacy is about controlling your personal information, not just keeping things secret. Non-sensitive data is used by companies to track your behavior, target ads, and influence your choices.\n\nFor email privacy, we recommend **[Proton](https://proton.me/mail)** and for search **[SearXNG](/storage#searx-instances)**. It's also good to check the HaveIBeenPwned **[email](https://haveibeenpwned.com/)** and [password](https://haveibeenpwned.com/Passwords) engines to make sure your info hasn't been part of any recent data breaches.\n\n**Note:** Never enter your real email or password on any site you don't know you can trust. Use a unique password for each site you register on. That way, if a breach occurs, only that one site's credentials are compromised. You can also take advantage of email [aliasing](/internet-tools#email-aliasing) for an extra layer of protection.\n\n**Note:** Keep in mind that it's **never** a good idea to upload personal or confidential files to any file host / cloud AI, even if they claim to be encrypted."},"entries":[],"subsections":[]},{"id":"windows-guide","title":"Windows Guide","refUrl":null,"crossrefRoute":null,"notice":{"kind":"tip","markdown":"**How can I download / activate Windows for free?**\n\nDownload an ISO from Massgrave's **[Genuine Installation Media](https://massgrave.dev/genuine-installation-media)** page, and follow the **[Clean Install Windows Guide](https://massgrave.dev/clean_install_windows)** to install it. After install, activate it with **[Microsoft Activation Scripts](https://rentry.co/FMHYB64#mas)**. If you'd like to use Windows 10 past its End-Of-Life date, follow **[Windows 10 After EOL](https://massgrave.dev/windows10_eol)**.\n\nNote you can turn on file extensions for all files by opening File Explorer, clicking on the \"View\" menu, and checking the box next to \"File name extensions.\""},"entries":[{"marker":null,"starred":false,"bold":true,"title":"Windows Install / Debloat Guide","url":"https://wispydocs.pages.dev/windows/","mirrors":[],"alternatives":[],"description":null,"tags":[],"platforms":[],"nsfw":false,"links":[],"code":[],"id":"beginners-guide/windows-guide/0","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Software Sites","url":null,"mirrors":[],"alternatives":[],"description":null,"tags":[],"platforms":[],"nsfw":false,"links":[{"label":"Virgil Software Search","url":"https://virgil.samidy.com/Software/","icon":null,"noteId":null,"route":null},{"label":"CracksURL","url":"https://cracksurl.com/","icon":null,"noteId":null,"route":null},{"label":"Download Guide","url":"https://cracksurl.com/how-to-download/","icon":null,"noteId":null,"route":null},{"label":"LRepacks","url":"https://lrepacks.net/","icon":null,"noteId":null,"route":null}],"code":[],"id":"beginners-guide/windows-guide/1","crossrefRoute":null}],"subsections":[]},{"id":"torrenting","title":"Torrenting","refUrl":null,"crossrefRoute":null,"notice":{"kind":"tip","markdown":"**Do I need a VPN to torrent?**\n\nDownloading files through torrenting can cause issues with your ISP, so using a **[VPN](/privacy#vpn)** is a must in most countries. You should also **[bind your VPN](https://wispydocs.pages.dev/torrenting/)** to your torrent client. This ensures that if your VPN connection drops, your torrent client stops all traffic, preventing your real IP address from being exposed. You can also use **[Remote Torrenting Services](/torrenting#remote-torrenting)** to avoid the need for a VPN altogether.\n\n**What is Port Forwarding? Do I need it?**\n\n[Port forwarding](https://wispydocs.pages.dev/torrenting/#port-forwarding) (having an open port) is an essential part of torrenting and it's recommended to set it up. While it's not strictly needed, it benefits the swarm, can sometimes boost download speeds, and improves connectability for torrents with fewer seeds."},"entries":[],"subsections":[]},{"id":"android-apps","title":"Android Apps","refUrl":null,"crossrefRoute":null,"notice":null,"entries":[{"marker":null,"starred":false,"bold":true,"title":"Mobilism","url":"https://forum.mobilism.org/viewforum.php?f=398","mirrors":[],"alternatives":[],"description":"Modded APKs","tags":["Modded APKs"],"platforms":[],"nsfw":false,"links":[],"code":[],"id":"beginners-guide/android-apps/0","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"APKMirror","url":"https://www.apkmirror.com/","mirrors":[],"alternatives":[],"description":"Untouched APKs","tags":["Untouched APKs"],"platforms":[],"nsfw":false,"links":[],"code":[],"id":"beginners-guide/android-apps/1","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Droid-ify","url":"https://droidify.app/","mirrors":[],"alternatives":[],"description":"FOSS Android Apps","tags":["FOSS Android Apps"],"platforms":[],"nsfw":false,"links":[{"label":"GitHub","url":"https://github.com/Droid-ify/client","icon":"github","noteId":null,"route":null}],"code":[],"id":"beginners-guide/android-apps/2","crossrefRoute":null},{"marker":null,"starred":false,"bold":true,"title":"Obtainium","url":"https://github.com/ImranR98/Obtainium/","mirrors":[],"alternatives":[],"description":"Get Android App Updates","tags":["Get Android App Updates"],"platforms":[],"nsfw":false,"links":[],"code":[],"id":"beginners-guide/android-apps/3","crossrefRoute":null}],"subsections":[]},{"id":"ios-sideloading","title":"iOS Sideloading","refUrl":null,"crossrefRoute":null,"notice":